# Browser configuration: these values are visible to every visitor.
# Replace locally; never commit real project IDs or authenticated endpoints.
VITE_REOWN_PROJECT_ID=
VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
VITE_ARC_RPC_FALLBACK_URL=https://rpc.mainnet.arc.io
VITE_PAPAYA_DOCS_URL=https://docs.papaya.finance
VITE_GITHUB_URL=https://github.com/Papaya-Finance/arc-demo
VITE_ENS_RPC_URL=

# Read-only keeper/fork configuration. Broadcasting is disabled by default.
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_FORK_BLOCK=24032582
BROADCAST=false
RUN_ONCE=true
MAX_GAS_COST_USDC=0.01
# Optional direct keeper invocation: set a public address in .env.local.
KEEPER_ADDRESS=
# Signing files must live outside the repository. Leave unset for dry-run mode.
KEYSTORE_FILE=
KEYSTORE_PASSWORD_FILE=
